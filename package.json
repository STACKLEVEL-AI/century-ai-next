{
  "name": "century-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "check:export": "node scripts/verify-export.mjs",
    "test:e2e": "playwright test",
    "assets:og": "node scripts/create-og.mjs",
    "assets:film": "node scripts/create-enterprise-film.mjs",
    "localize": "node scripts/i18n/generate.mjs",
    "predev": "npm run localize",
